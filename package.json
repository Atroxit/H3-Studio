{
  "name": "h3-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local desktop studio for MiniMax H3 Image: live diffusion previews, vision-aware prompt enhancement, and hardware-aware auto-tuning.",
  "license": "MIT",
  "author": "Atroxit",
  "homepage": "https://github.com/Atroxit/H3-Studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atroxit/H3-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/Atroxit/H3-Studio/issues"
  },
  "keywords": [
    "minimax-h3",
    "comfyui",
    "image-generation",
    "electron",
    "react",
    "typescript",
    "rocm",
    "cuda",
    "local-first"
  ],
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "desktop:build": "npm run build && esbuild src/server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server/main.cjs",
    "desktop": "npm run desktop:build && node scripts/desktop.mjs",
    "desktop:package": "npm run desktop:build && electron-builder --win --x64",
    "desktop:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-shortcut.ps1",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "build": {
    "appId": "com.atroxit.h3studio",
    "productName": "H3 Studio",
    "copyright": "Copyright © 2026 Atroxit",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "electron/main.cjs",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "dist/server",
        "to": "server"
      },
      {
        "from": "dist/web",
        "to": "web"
      },
      {
        "from": "electron/h3-studio.ico",
        "to": "h3-studio.ico"
      }
    ],
    "win": {
      "icon": "electron/h3-studio.ico",
      "artifactName": "H3-Studio-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "H3 Studio",
      "artifactName": "H3-Studio-Setup-${version}-win-${arch}.${ext}"
    }
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
